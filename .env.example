# Public canonical URL used in shared posts. Example:
# VITE_PUBLIC_APP_URL=https://picture-score.example.com
VITE_PUBLIC_APP_URL=

# Stripe Checkout or Payment Link URL. Keep test and live URLs in deployment secrets,
# never in source control.
VITE_STRIPE_CHECKOUT_URL=

# Safety gate. Leave false until checkout fulfillment / entitlement is implemented.
# Set true only for an explicitly reviewed test or production rollout.
VITE_PLUS_PURCHASE_ENABLED=false
